<?xml version="1.0" ?>
<PluginList>
  <Plugin id="SE Wave Recorder2" name="Wave Recorder2" category="Input-Output">
    <Audio>
        <Pin name="File Name" datatype="string" default="Wavefile" isFilename="true" metadata="wav" />
        <Pin name="Format" datatype="enum"  metadata="16 bit, 32 bit float" />
        <Pin name="Time Limit" datatype="float" direction="in"/>
        <Pin name="on" datatype="enum"  metadata="off=0,on=1" />
        <Pin name="FS/spl" datatype="float"  direction="out"/>
        <Pin name="Spl" datatype="float"  direction="out"/>
        <Pin name="Written" datatype="float"  direction="out"/>
        <Pin name="Mul FS" datatype="int"  direction="in" />
        <Pin name="Preview" datatype="enum"  metadata="off=0, on=1" />
        <Pin name="Output" direction="out" datatype="float" rate="audio"/>
        <Pin name="Mul loop" datatype="enum"  metadata="range 1,40" />
        <Pin name="Input" datatype="float" rate="audio" linearInput="true" autoDuplicate="true" />
    </Audio>
  </Plugin>
</PluginList>
