   <Plugin id="CK PolyBlep Oscillator" name="CK PolyBlep Osc" category="CK Tools" graphicsApi="none">
    <Audio>
      <Pin name="Pitch" datatype="float" rate="audio" default="0.5" />
      <Pin name="Pulse Width" datatype="float" rate="audio" default="0.5" />
      <Pin name="Phase Mod" datatype="float" rate="audio" default="0.0" />
      <Pin name="Sync or Gate" datatype="float" rate="audio" default="0.0" />
      <Pin name="Int Sync Pitch" datatype="float" rate="audio" default="0.0" />
      <Pin name="Waveform" datatype="enum" default="1" metadata="Sine,Saw,Ramp,Tri,Pulse,White,Pink" />
      <Pin name="SyncType" datatype="enum" default="0" metadata="off,Int(HQ),ExtSync" />
      <Pin name="Over Factor" datatype="enum" default="8" metadata="x2=2,x4=4,x8=8,x16=16" />
      <Pin name="Bypass" datatype="bool" default="false" />
      <Pin name="Reset Mode" datatype="enum" metadata="Free,Gate,GateVoice,Voice" />
      <Pin name="Audio Out" datatype="float" rate="audio" direction="out" />
      <Pin name="VoiceActive" datatype="float" private="true" isPolyphonic="true" hostConnect="Voice/Active" />
      <Pin name="Volt Limit" datatype="enum" default="1" metadata="10,10.33,10.5" />
      <Pin name="CutOff" datatype="float" rate="audio" default="1.05" />
    </Audio>
  </Plugin>


</PluginList>
