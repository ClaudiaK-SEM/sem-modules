<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="KX-Hz" />
		<Option platforms="Windows;" />
		<Option pch_mode="0" />
		<Option compiler="msvc10" />
		<Build>
			<Target title="2005 Win32 Release">
				<Option platforms="Windows;" />
				<Option output="2005/Msv5 KX-Hz.sem" prefix_auto="0" extension_auto="0" />
				<Option object_output="./2005" />
				<Option type="3" />
				<Option compiler="msvc10" />
				<Option createDefFile="1" />
				<Option createStaticLib="1" />
				<Compiler>
					<Add option="/MT" />
					<Add option="/arch:SSE2" />
					<Add option="/GA" />
					<Add option="/fp:fast" />
					<Add option="/EHs" />
					<Add option="/Ot" />
					<Add option="/O2" />
					<Add option="/W3" />
					<Add option="/DWIN32" />
					<Add option="/DNDEBUG" />
					<Add option="/D_WINDOWS" />
					<Add option="/DWINDOWS=1" />
					<Add option="/DMSV" />
					<Add option="/D_CRT_SECURE_NO_WARNINGS" />
					<Add directory="../se_sdk2" />
				</Compiler>
				<Linker>
					<Add option="kernel32.lib user32.lib" />
					<Add option="gdi32.lib winspool.lib comdlg32.lib" />
					<Add option="advapi32.lib shell32.lib ole32.lib" />
					<Add option="oleaut32.lib uuid.lib odbc32.lib" />
					<Add option="odbccp32.lib" />
				</Linker>
			</Target>
		</Build>
		<Unit filename="../se_sdk2/SEGUI_Pin.cpp" />
